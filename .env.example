NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-long-random-string-here
# OAuth providers (create apps and paste your own credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
MONGO_URL=your-mongodb-connection-string-here
# Database containing the cards and decks collections.
MONGO_DB_NAME=legions_battleground_db

# Cloudflare R2 card-image migration (server-side only; do not use EXPO_PUBLIC_)
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BUCKET=legions-card-images
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Used by the app after the sync, not by the upload script itself.
R2_PUBLIC_BASE_URL=https://your-public-r2-development-url
